<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_logo_light"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_student_wallet_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Wallet"
                    android:textColor="@color/navy_dark"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Crear cuenta"
                android:textColor="@color/navy_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblRegName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nombre completo"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ej. Juan Pérez"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/iconErrName"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_error_outline"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Campos obligatorios vacíos"
                android:textColor="@color/red_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblRegEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Correo electrónico"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="juan.perez@universidad.edu"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/iconErrEmail"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_error_outline"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Correo inválido"
                android:textColor="@color/red_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Contraseña"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnToggleRegPass"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblRegConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirmar contraseña"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegConfirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegConfirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnToggleRegConfirm"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Contraseñas diferentes"
                android:textColor="@color/red_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblRegCareer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Carrera universitaria"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegCareer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegCareer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ej. Ingeniería en Ciencias de la Computación"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/iconErrCareer"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_error_outline"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrCareer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Campos obligatorios vacíos"
                android:textColor="@color/red_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblRegUni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Universidad"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/boxRegUni"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <EditText
                    android:id="@+id/etRegUni"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ej. Universidad Don Bosco"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#6F7787"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Moneda local"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_spinner_rounded"
                android:paddingHorizontal="10dp">

                <Spinner
                    android:id="@+id/spRegCurrency"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_button_navy"
                android:text="Crear cuenta"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="6dp"
                android:text="¿Ya tienes una cuenta? Iniciar sesión"
                android:textColor="@color/blue_primary"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
